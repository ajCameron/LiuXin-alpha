# Interlink table requests (FRBR generator)
#
# Each [[interlinks]] entry requests an interlink table between two existing main tables.
# Add your "why this exists" notes in `rationale` (safe to be long / multi-line).
#
# NOTE: The generator normalises table names via match_to_table_name() (plural/singular fuzz).

version = 1
allow_redundant_links = true
warn_on_redundant_links = true

[[interlinks]]
left_table = "agents"
right_table = "comments"
link_type = "one_to_many"
rationale = """You want to be able to make comments on a generic agent"""

[[interlinks]]
left_table = "agents"
right_table = "expressions"
link_type = "many_to_many"
rationale = """Which expressions the agents are responsible for"""

[[interlinks]]
left_table = "agents"
right_table = "feeds"
link_type = "many_to_many"
rationale = """Agents also create and manage feeds of various sorts. Tags which agents"""

[[interlinks]]
left_table = "agents"
right_table = "images"
link_type = "many_to_many"
rationale = """You can assign pictures to agents - such as cover photos"""

[[interlinks]]
left_table = "agents"
right_table = "items"
link_type = "many_to_many"
rationale = """Agents can be responsible for different parts of each part of the WEMI stack"""

[[interlinks]]
left_table = "agents"
right_table = "labels"
link_type = "many_to_many"
rationale = """You can label agents in various ways"""

[[interlinks]]
left_table = "agents"
right_table = "languages"
link_type = "many_to_many"
rationale = """Agents can work in different languages (e.g. Alistair Reynaulds is an English language author). (Orbit is an English language publishing housre)"""

[[interlinks]]
left_table = "agents"
right_table = "manifestations"
link_type = "many_to_many"
rationale = """Agents can be responsible for creating manifestations."""

[[interlinks]]
left_table = "agents"
right_table = "synopses"
link_type = "many_to_many"
rationale = """A synopses of an agent conveys infomation about the agent."""

[[interlinks]]
left_table = "agents"
right_table = "works"
link_type = "many_to_many"
rationale = """An Agent can be responsible for creating a work (e.g. a report commisioned by a body)."""

[[interlinks]]
left_table = "comments"
right_table = "compressed_files"
link_type = "many_to_many"
rationale = """Comment on a compressed files - e.g. what might be in it."""

[[interlinks]]
left_table = "comments"
right_table = "conversion_options"
link_type = "many_to_many"
rationale = """Comment on a conversion option - doe it produce good output? E.t.c."""

[[interlinks]]
left_table = "comments"
right_table = "custom_columns"
link_type = "many_to_many"
rationale = """Comment on a custom column - what does it do?"""

[[interlinks]]
left_table = "comments"
right_table = "devices"
link_type = "many_to_many"
rationale = """Comment on a device - provides more info about it."""

[[interlinks]]
left_table = "comments"
right_table = "expressions"
link_type = "many_to_many"
rationale = """You can comment on an expressions. If you want."""

[[interlinks]]
left_table = "comments"
right_table = "feeds"
link_type = "many_to_many"
rationale = """You can comment on a feed."""

[[interlinks]]
left_table = "comments"
right_table = "human_agents"
link_type = "many_to_many"
rationale = """You can comment on a human_agent - in their role as a human. And an agent."""

